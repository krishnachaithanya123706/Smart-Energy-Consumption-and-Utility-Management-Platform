class User:
    def __init__(self, id, name, email, utility_type):
        self.id = id
        self.name = name
        self.email = email
        self.utility_type = utility_type
class Consumption:
    def __init__(self, id, user_id, utility_type, consumption, date):
        self.id = id
        self.user_id = user_id
        self.utility_type = utility_type
        self.consumption = consumption
        self.date = date